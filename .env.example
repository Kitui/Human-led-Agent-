OPENAI_API_KEY=replace_with_your_key
DATABASE_URL=postgresql+asyncpg://agent_lab:agent_lab@localhost:5544/agent_lab
JWT_SECRET_KEY=replace_with_a_random_secret_at_least_32_characters
TASK_GITHUB_TOKEN=replace_with_a_fine_grained_token_with_issues_read_write
TASK_GITHUB_REPOSITORY=owner/repository
TASK_GITHUB_API_URL=https://api.github.com

# Demo login accounts are OFF by default. Enable only for an intentional
# local/demo environment and provide your own strong passwords.
ENABLE_DEMO_USERS=false
DEMO_RED_PASSWORD=replace_with_at_least_16_characters
DEMO_GREEN_PASSWORD=replace_with_at_least_16_characters
DEMO_ADMIN_PASSWORD=replace_with_at_least_16_characters
